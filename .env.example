# Copia este fichero a ".env" y rellena tus valores.
# El aviso por Telegram solo se envía si ambas variables están definidas.

# Token del bot, te lo da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tu chat_id (a dónde se envía el aviso).
# Para obtenerlo: escribe a tu bot y abre
#   https://api.telegram.org/bot<TU_TOKEN>/getUpdates
# El chat_id aparece en result[].message.chat.id
TELEGRAM_CHAT_ID=123456789
